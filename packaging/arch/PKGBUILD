# Maintainer: Emon <emon@users.noreply.github.com>
#
# Emon para Arch Linux, CachyOS, EndeavourOS y Manjaro.
#   makepkg -si

pkgname=emon
pkgver=0.3.0
pkgrel=1
_commit=571f04a4313dc328eb9d72cfde7782d5df26ca80
pkgdesc="Panel de emojis y símbolos al estilo de Windows (Super+.)"
arch=('any')
url="https://github.com/anrennnn/Emon-Linux-MacOS"
license=('MIT' 'Unicode-3.0')
depends=(
    'python'
    'python-pyqt6'
    'python-gobject'
    'qt6-base'
    'noto-fonts-emoji'
    'libnotify'
    'hicolor-icon-theme'
)
makedepends=('make')
optdepends=(
    'xdotool: escribir el emoji en la aplicación activa (X11)'
    'wtype: escribir el emoji en la aplicación activa (Hyprland, Sway, niri)'
    'ydotool: pegar el emoji automáticamente en KDE Plasma y GNOME con Wayland'
    'qt6-wayland: ventana nativa en sesiones Wayland'
)
conflicts=('emojis-linux')
replaces=('emojis-linux')  # hasta la 0.2 se llamaba así
install=emon.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('e25ad4be4d2b0abee8c9446c0202eefa08f7d926e7ef1237400081b872b2794e')

package() {
    cd "Emon-Linux-MacOS-$_commit"
    make install DESTDIR="$pkgdir" PREFIX=/usr \
        DOCDIR=/usr/share/licenses/$pkgname LICENSE_NAME=LICENSE
}
