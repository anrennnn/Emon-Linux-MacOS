# Maintainer: Emojis-Linux <emojis-linux@users.noreply.github.com>
#
# Emojis para Arch Linux, CachyOS, EndeavourOS y Manjaro.
#   makepkg -si

pkgname=emojis-linux
pkgver=0.2.0
pkgrel=1
_commit=2a82cb547f5166df475e003cd7cc2a9b27191529
pkgdesc="Panel de emojis y símbolos al estilo de Windows (Super+.)"
arch=('any')
url="https://github.com/anrennnn/EMON-Linux-MacOS"
license=('MIT' 'Unicode-3.0')
depends=(
    'python'
    'python-pyqt6'
    'python-gobject'
    'qt6-base'
    'noto-fonts-emoji'
    'libnotify'
    'hicolor-icon-theme'
)
makedepends=('make')
optdepends=(
    'xdotool: escribir el emoji en la aplicación activa (X11)'
    'wtype: escribir el emoji en la aplicación activa (Hyprland, Sway, niri)'
    'ydotool: pegar el emoji automáticamente en KDE Plasma y GNOME con Wayland'
    'qt6-wayland: ventana nativa en sesiones Wayland'
)
install=emojis-linux.install
source=("$pkgname-$pkgver.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('ad7b0ca603d849ce40165385976f480b3c6d05539e5d6f768511c8be6a7cb220')

package() {
    cd "EMON-Linux-MacOS-$_commit"
    make install DESTDIR="$pkgdir" PREFIX=/usr \
        DOCDIR=/usr/share/licenses/$pkgname LICENSE_NAME=LICENSE
}
