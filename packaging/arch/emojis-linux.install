post_install() {
    echo ">> Abre «Emojis» desde el menú una vez (o reinicia la sesión) para activar Super+."
    echo ">> En Hyprland, Sway o niri, Emojis te dirá qué línea añadir a tu configuración."
}

post_upgrade() {
    echo ">> Reinicia Emojis para usar la nueva versión: emojis-linux salir && emojis-linux segundo-plano &"
}

pre_remove() {
    rm -rf /usr/lib/emojis-linux/emojis_linux/__pycache__
}
