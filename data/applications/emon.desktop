[Desktop Entry]
Type=Application
Name=Emon
GenericName=Panel de emojis
Comment=Emojis y símbolos al estilo de Windows (Super+.)
Exec=emon abrir
Icon=emon
Terminal=false
Categories=Utility;
Keywords=emon;emoji;emojis;símbolos;symbols;caritas;kaomoji;unicode;
StartupNotify=false
Actions=simbolos;ajustes;
X-KDE-Shortcuts=Meta+.

[Desktop Action simbolos]
Name=Símbolos
Exec=emon simbolos
X-KDE-GlobalAccel-CommandShortcut=true

[Desktop Action ajustes]
Name=Cambiar los atajos de teclado
Exec=emon ajustes
X-KDE-GlobalAccel-CommandShortcut=true
