[Desktop Entry]
Type=Application
Name=Emojis
GenericName=Panel de emojis
Comment=Emojis y símbolos al estilo de Windows (Super+.)
Exec=emojis-linux abrir
Icon=emojis-linux
Terminal=false
Categories=Utility;
Keywords=emoji;emojis;símbolos;symbols;caritas;kaomoji;unicode;
StartupNotify=false
Actions=simbolos;ajustes;
X-KDE-Shortcuts=Meta+.,Meta+;

[Desktop Action simbolos]
Name=Símbolos
Exec=emojis-linux simbolos

[Desktop Action ajustes]
Name=Cambiar el atajo de teclado
Exec=emojis-linux ajustes
